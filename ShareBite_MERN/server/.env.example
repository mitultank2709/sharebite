NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/sharebite
CLIENT_ORIGIN=http://localhost:5173
JWT_ACCESS_SECRET=replace_with_random_secret_at_least_32_characters
JWT_REFRESH_SECRET=replace_with_another_random_secret_at_least_32_characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
ADMIN_NAME=ShareBite Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisPassword123!
